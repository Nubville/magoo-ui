{
  "name": "magoo-ui",
  "version": "0.0.0",
  "description": "A design system of Drupal single directory components. Ships as authored: no build step for consumers.",
  "private": true,
  "license": "MIT",
  "author": "Drew Garman <garman.andrew@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && stylelint \"**/*.css\" && prettier --check .",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix && prettier --write .",
    "validate": "node scripts/validate-components.mjs && node scripts/validate-tokens.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@vitest/browser-playwright": "^4.1.11",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "colorjs.io": "^0.7.1",
    "drupal-attribute": "^1.2.1",
    "drupal-twig-extensions": "1.0.0-beta.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.0",
    "js-yaml": "^5.4.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "twig": "^1.17.1",
    "vite": "^7.3.6",
    "vite-plugin-twig-drupal": "^1.6.2",
    "vitest": "^4.1.11"
  }
}
